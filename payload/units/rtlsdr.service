[Unit]
Description=RTL-SDR web console
After=NetworkManager.service
Wants=rtlsdr-wifi.service

[Service]
Type=simple
Environment=RTLSDR_DATA=/var/lib/rtlsdr-pi
Environment=RTLSDR_PORT=80
ExecStart=/usr/bin/python3 /opt/rtlsdr-pi/app/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
